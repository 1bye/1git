{
  "name": "@1git/git",
  "version": "0.0.1",
  "private": true,
  "description": "Structured repository control for 1git applications",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./process": {
      "types": "./dist/process/git-process.d.ts",
      "import": "./dist/process/git-process.js"
    },
    "./progress": {
      "types": "./dist/process/git-progress.d.ts",
      "import": "./dist/process/git-progress.js"
    },
    ".": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js"
    }
  },
  "scripts": {
    "playground": "bun scripts/playground.ts",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  }
}
