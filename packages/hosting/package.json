{
  "name": "@1git/hosting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./avatars": {
      "types": "./dist/avatars.d.ts",
      "import": "./dist/avatars.js"
    },
    ".": {
      "types": "./dist/hosting.d.ts",
      "import": "./dist/hosting.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./device-oauth": {
      "types": "./dist/device-oauth.d.ts",
      "import": "./dist/device-oauth.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./providers/github": {
      "types": "./dist/providers/github/provider.d.ts",
      "import": "./dist/providers/github/provider.js"
    },
    "./providers/gitlab": {
      "types": "./dist/providers/gitlab/provider.d.ts",
      "import": "./dist/providers/gitlab/provider.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test tests/unit tests/component tests/consumer",
    "test:integration": "bun test tests/integration"
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.20.1",
    "emulate": "0.12.0",
    "typescript": "^6.0.3"
  }
}
