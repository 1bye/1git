{
  "name": "1git",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "check": "bun run lint && bun run format:check",
    "fix": "bun run format && bun run lint:fix",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^22.20.1",
    "lefthook": "latest",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@gpuix/native@0.10.0": "patches/@gpuix%2Fnative@0.10.0.patch"
  }
}
