{
  "name": "1git",
  "private": true,
  "description": "A native Git workspace for macOS, with local and SSH repositories, worktrees, and AI commit messages.",
  "license": "MIT",
  "homepage": "https://git.1bye.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/1bye/1git.git"
  },
  "bugs": {
    "url": "https://github.com/1bye/1git/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "playground": "bun run --cwd packages/git playground",
    "dev": "turbo run dev",
    "dev:app": "ONEGIT_LAUNCHER_CWD=\"$PWD\" turbo run dev --filter=@1git/gpuix --",
    "dev:web": "turbo run dev --filter=@1git/web",
    "build:web": "turbo run build --filter=@1git/web",
    "build": "turbo run build",
    "package:macos": "turbo run package:macos --filter=@1git/gpuix",
    "setup:signing:macos": "turbo run setup:signing:macos --filter=@1git/gpuix",
    "test:signing:macos": "turbo run test:signing:macos --filter=@1git/gpuix",
    "test:package:macos": "turbo run test:package:macos --filter=@1git/gpuix",
    "test:updates:macos": "turbo run test:updates:macos --filter=@1git/gpuix",
    "prepare:updates:macos": "turbo run prepare:updates:macos --filter=@1git/gpuix",
    "release:macos": "turbo run release:macos --filter=@1git/gpuix --",
    "test:release:transport": "turbo run test:release:transport --filter=@1git/gpuix",
    "test:release:macos": "turbo run test:release:macos --filter=@1git/gpuix",
    "deploy:updates": "turbo run deploy:updates --filter=@1git/releases --",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:portable": "turbo run test --filter=!@1git/gpuix --filter=!@1git/gpuix-ui",
    "check": "bun run lint && bun run format:check",
    "fix": "bun run format && bun run lint:fix",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@changesets/cli": "3.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^22.20.1",
    "lefthook": "latest",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@gpuix/native@0.10.0": "patches/@gpuix%2Fnative@0.10.0.patch"
  }
}
