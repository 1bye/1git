  "cases": [
    {
      "name": "mixed-working",
      "steps": [
        {
          "kind": "write",
          "path": "file",
          "content": "one\ntwo\n"
        },
        {
          "kind": "git",
          "args": [
            "add",
            "--all"
          ]
        },
        {
          "kind": "git",
          "args": [
            "commit",
            "-m",
            "initial"
          ]
        },
        {
          "kind": "write",
          "path": "file",
          "content": "one\nstaged\n"
        },
        {
          "kind": "git",
          "args": [
            "add",
            "--",
            "file"
          ]
        },
        {
          "kind": "write",
          "path": "file",
          "content": "one\nworking-final\n"
        },
        {
          "kind": "write",
          "path": "untracked",
          "content": "new\n"
        }
      ],
      "options": {
        "target": {
          "kind": "working"
        }
      },
      "expected": {
        "patch": "diff --git a/file b/file\nindex c7847ad..a5b1bf2 100644\n--- a/file\n+++ b/file\n@@ -1,2 +1,2 @@\n one\n-staged\n+working-final\n\ndiff --git a/untracked b/untracked\nnew file mode 100644\nindex 0000000..3e75765\n--- /dev/null\n+++ b/untracked\n@@ -0,0 +1 @@\n+new\n",
        "stats": [
          {
            "addedLines": 1,
            "deletedLines": 1,
            "path": "file"
          },
          {
            "path": "untracked",
            "addedLines": 1,
            "deletedLines": 0
          }
        ],
        "target": {
          "kind": "working"
        }
      }
    },
