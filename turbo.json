{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {},
    "build:native": {
      "cache": false
    },
    "package:macos": {
      "dependsOn": ["^build", "build:native"],
      "cache": false,
      "passThroughEnv": [
        "DEVELOPER_DIR",
        "ONEGIT_UPDATE_FEED_URL",
        "ONEGIT_UPDATE_PUBLIC_KEY",
        "ONEGIT_RELEASE_VERSION"
      ]
    },
    "test:package:macos": {
      "dependsOn": ["package:macos"],
      "cache": false
    },
    "test:updates:macos": {
      "dependsOn": ["package:macos"],
      "cache": false
    },
    "prepare:updates:macos": {
      "dependsOn": ["package:macos"],
      "cache": false,
      "passThroughEnv": ["ONEGIT_UPDATE_KEY_FILE"]
    },
    "release:macos": {
      "dependsOn": ["^build", "build:native", "check-types"],
      "cache": false,
      "passThroughEnv": [
        "DEVELOPER_DIR",
        "ONEGIT_UPDATE_PUBLIC_KEY",
        "ONEGIT_UPDATE_KEY_FILE",
        "ALCHEMY_PROFILE",
        "ALCHEMY_HOME"
      ]
    },
    "deploy:updates": {
      "cache": false,
      "passThroughEnv": ["ONEGIT_UPDATE_PUBLIC_KEY", "CLOUDFLARE_*", "ALCHEMY_*"]
    },
    "test:release:transport": {
      "cache": false
    },
    "test:release:macos": {
      "dependsOn": ["^build", "build:native"],
      "cache": false,
      "passThroughEnv": ["DEVELOPER_DIR"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
