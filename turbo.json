{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {},
    "build:native": { "cache": false },
    "package:macos": {
      "dependsOn": ["^build", "build:native"],
      "cache": false,
      "passThroughEnv": [
        "DEVELOPER_DIR",
        "ONEGIT_UPDATE_FEED_URL",
        "ONEGIT_UPDATE_PUBLIC_KEY"
      ]
    },
    "test:package:macos": {
      "dependsOn": ["package:macos"],
      "cache": false
    },
    "test:updates:macos": { "dependsOn": ["package:macos"], "cache": false },
    "prepare:updates:macos": {
      "dependsOn": ["package:macos"],
      "cache": false,
      "passThroughEnv": ["ONEGIT_UPDATE_KEY_FILE"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
