---
import AppWindow from "./AppWindow.astro";
import WindowClouds from "./WindowClouds.astro";
const machineSizes = "(max-width:767px) calc(100vw - 48px), (max-width:1328px) calc(38vw - 98.24px), 407px";
---
<article class="connection-section" aria-labelledby="remote-title" data-reveal data-scene="remote">
  <div class="scene-content" data-scene-motion>
  <h3 data-scene-text class="display" id="remote-title">Remote</h3>
  <h4 data-scene-text style="--scene-delay:100ms" class="display">Local or SSH. One workspace.</h4>
  <div class="connection-world">
    <figure class="machine"><div class="cloud-frame" data-scene-window>
      <AppWindow name="home-machines" sizes={machineSizes} alt="Home Machines view on This Mac with Devbox connected and its repositories listed." />
    <svg class="connection-lines connection-lines-desktop" viewBox="0 0 1000 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
      {Array.from({length:11},(_,i) => <path d={`M0 ${40+i*32} C350 ${40+i*32} 420 200 550 200`} stroke={i === 3 ? "var(--line-blue)" : "white"} stroke-width="1.3" pathLength="1" style={`--order:${i}`} />)}
      <path d="M550 200H1000" stroke="white" stroke-width="1.5" pathLength="1" style="--order:11" />
    </svg>
      <WindowClouds />
    </div><figcaption>This Mac</figcaption></figure>
    <svg class="connection-lines connection-lines-mobile" viewBox="0 0 400 120" preserveAspectRatio="none" fill="none" aria-hidden="true">
      {Array.from({length:11},(_,i) => <path d={`M${50+i*30} 0 C${50+i*30} 42 200 42 200 70`} stroke={i === 3 ? "var(--line-blue)" : "white"} stroke-width="1.3" pathLength="1" style={`--order:${i}`} />)}
      <path d="M200 70V120" stroke="white" stroke-width="1.5" pathLength="1" style="--order:11" />
    </svg>
    <figure class="machine"><div class="cloud-frame" data-scene-window><AppWindow name="devbox-remote" sizes={machineSizes} alt="Remote repository on Devbox with the tab labelled 1git / main · Devbox." /><WindowClouds /></div><figcaption>Devbox<code>ssh yurii@devbox</code></figcaption></figure>
  </div>
  </div>
</article>
