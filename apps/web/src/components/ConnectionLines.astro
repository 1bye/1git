---
import AppWindow from "./AppWindow.astro";
import WindowClouds from "./WindowClouds.astro";
const machineSizes = "(max-width:650px) calc(100vw - 48px), (max-width:1328px) calc(38vw - 98.24px), 407px";
---
<article class="connection-section" aria-labelledby="remote-title" data-reveal data-scene="remote">
  <div class="scene-content" data-scene-motion>
  <h3 class="display" id="remote-title">Remote</h3>
  <h4 class="display">Local or SSH. One workspace.</h4>
  <div class="connection-world">
    <figure class="machine"><div class="cloud-frame"><AppWindow name="home-machines" sizes={machineSizes} alt="Home Machines view on This Mac with Devbox connected and its repositories listed." /><WindowClouds /></div><figcaption>This Mac</figcaption></figure>
    <svg class="connection-lines" viewBox="0 0 1000 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
      {Array.from({length:11},(_,i) => <path d={`M300 ${40+i*30} C440 ${40+i*30} 430 200 500 200`} stroke={i === 3 ? "var(--line-blue)" : i === 7 ? "var(--line-green)" : "white"} stroke-width="1.3" pathLength="1" style={`--order:${i}`} />)}
      <path d="M500 200H700" stroke="white" stroke-width="1.5" pathLength="1" style="--order:11" />
    </svg>
    <figure class="machine"><div class="cloud-frame"><AppWindow name="devbox-remote" sizes={machineSizes} alt="Remote repository on Devbox with the tab labelled 1git / main · Devbox." /><WindowClouds /></div><figcaption>Devbox<code>ssh yurii@devbox</code></figcaption></figure>
  </div>
  </div>
</article>
