---
import { Image } from "astro:assets";
import nativeWindow from "../assets/launch/native-window.webp";
import original from "../assets/1git-native-window.png";
interface Props { eager?: boolean; progressive?: boolean; class?: string }
const { eager = false, progressive = false, class: className } = Astro.props;
---
<a class:list={["app-window", className]} href={original.src} target="_blank" rel="noopener" aria-label="View the full-size 1git app screenshot">
  <Image src={nativeWindow} widths={[640, 960, 1440, 2143]} sizes={progressive ? "(max-width: 650px) 125vw, (max-width: 1100px) 90vw, 1120px" : "(max-width: 650px) 94vw, (max-width: 1100px) 90vw, 1120px"} format="webp" quality={88} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} alt="1git’s native macOS window with repository tabs, a stash, and a file diff." />
  {progressive && <div class="progressive-blur" aria-hidden="true">
    {[1,2,3,4,5].map((i) => <span class={`blur-band band-${i}`}><Image class="blur-image" src={nativeWindow} widths={[640, 960, 1440, 2143]} sizes="(max-width: 650px) 125vw, (max-width: 1100px) 90vw, 1120px" format="webp" quality={88} loading="eager" alt="" /></span>)}
  </div>}
</a>
