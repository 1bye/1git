---
import Icon from "./Icon.astro";
const columns = [
  { title: "History", rows: [
    {icon:"history", text:"Every commit.", detail:"At a glance."},
    {icon:"lock", text:"Ignored files.", detail:"Local history, too."},
    {icon:"archive", text:"Multiple stashes.", detail:"Pick up any time."},
    {icon:"fileArrow", text:"File history.", detail:"Across renames."},
  ]},
  { title: "Branches", rows: [
    {icon:"gitBranch", text:"Branches & worktrees.", detail:""},
    {icon:"compare", text:"Compare branches", detail:""},
    {icon:"accounts", text:"Your accounts.", detail:"GitHub, GitLab, GitHub CLI"},
  ]},
  { title: "Workspace", rows: [
    {icon:"spaces", text:"Work and personal.", detail:"Separate spaces."},
    {icon:"fileCode", text:"Your file types.", detail:"Your choice of editor."},
    {icon:"command", text:"Stay on your keyboard.", detail:"⌘P"},
  ]},
] as const;

const coming = [{icon:"pullRequest",label:"Pull requests"},{icon:"circleDot",label:"Issues"}] as const;
---
<section class="even-more" aria-labelledby="even-more-title" data-reveal data-scene="more">
  <div class="scene-content" data-scene-motion>
  <h2 data-scene-text class="display" id="even-more-title">Even more.</h2>
  <div class="feature-columns">
    {columns.map(({title,rows}) => <div class="feature-column"><h3 data-scene-text style="--scene-delay:120ms">{title}</h3>
      {rows.map(({icon,text,detail}) => <div class="feature-row" data-scene-text style="--scene-delay:200ms" data-icon={icon}><span class="icon-tile"><Icon name={icon} size={24} /></span><div>{text}{detail && <small>{detail}</small>}</div></div>)}
    </div>)}
  </div>
  <div class="coming-soon">
    <h3 data-scene-text style="--scene-delay:180ms">Coming soon</h3>
    {coming.map(({icon,label}) => <div class="coming-item" data-scene-text style="--scene-delay:200ms"><span class="icon-tile"><Icon name={icon} size={24} /></span><span class="coming-label">{label}</span></div>)}
  </div>
  </div>
</section>
