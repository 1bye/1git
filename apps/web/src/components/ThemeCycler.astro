---
import AppWindow from "./AppWindow.astro";
import WindowClouds from "./WindowClouds.astro";

const blurSteps = [2, 5, 8, 12, 16, 20, 25, 30];

const themes = [
  { name: "Rose", wallpaper: "clouds", screen: "theme-rose" },
  { name: "Forest", wallpaper: "forest", screen: "theme-forest" },
  { name: "Cosmic", wallpaper: "night-meadow", screen: "theme-cosmic" },
  { name: "Workshop", wallpaper: "ocean", screen: "theme-workshop" },
] as const;
---
<section class="theme-section" data-theme-cycler aria-labelledby="themes-title" data-scene="themes">
  <div class="scene-content" data-scene-motion>
  <h3 data-scene-text id="themes-title" class="display">Make every repo yours.</h3>
  <div class="cloud-frame" data-scene-window>
  <div class="theme-stage">
    {themes.map(({name,wallpaper},i) => <img class="theme-wallpaper" src={`/images/themes/${wallpaper}.webp`} width="1920" height="1080" loading="lazy" alt={`${name} theme wallpaper: ${wallpaper.replaceAll("-", " ")}.`} data-theme-frame={i} data-active={i === 0 ? "" : undefined} aria-hidden={i !== 0} />)}
    <div class="theme-windows">
      {themes.map(({name,screen},i) => <div class="theme-capture" data-theme-frame={i} data-active={i === 0 ? "" : undefined} aria-hidden={i !== 0} inert={i !== 0}>
        <AppWindow name={screen} sizes="(max-width:767px) 82vw, (max-height:759px) 100vw, min(65.575svh,100vw)" alt={`The same repository window in the ${name} theme, including its matching colour and pattern.`} />
      </div>)}
    </div>
  </div>
  <div class="theme-edge-blur" aria-hidden="true">
      {blurSteps.map((target,i) => {
        const previous = blurSteps[i-1] ?? 0;
        const radius = Math.sqrt(target * target - previous * previous);
        return <span class="blur-slice" style={`--blur:${radius.toFixed(2)}px;--solid:${(7-i)/8};--fade:${(8-i)/8}`} />;
      })}
  </div>
  <WindowClouds />
  </div>
  <div class="theme-controls" role="group" aria-label="Repository themes" data-pill-scenes>
    <svg class="pill-scenes" aria-hidden="true"></svg>
    {themes.map(({name},i) => <button type="button" aria-pressed={i === 0} data-theme-index={i}>{name}</button>)}
  </div>
  </div>
</section>

<script>
  import { initPillScenes } from "../scripts/theme-pill-scenes";
  initPillScenes();
</script>
