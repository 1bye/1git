---
interface Props {
  feature: "gpu" | "changes" | "branches" | "spaces" | "remote" | "cli" | "history" | "stash" | "keyboard";
}

const { feature } = Astro.props;
const id = `feature-${feature}`;
const silver = `url(#${id}-silver)`;
const face = `url(#${id}-face)`;
const edge = `url(#${id}-edge)`;
const shadow = `url(#${id}-shadow)`;
---

<div class:list={["feature-illustration", `illustration-${feature}`]} aria-hidden="true">
  <svg viewBox="0 0 400 300" fill="none" focusable="false">
    <defs>
      <linearGradient id={`${id}-silver`} x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#fff" /><stop offset=".35" stop-color="#e7eaee" /><stop offset=".72" stop-color="#c8cdd5" /><stop offset="1" stop-color="#eef0f3" />
      </linearGradient>
      <linearGradient id={`${id}-face`} x1="0" y1="0" x2=".6" y2="1">
        <stop stop-color="#fff" /><stop offset="1" stop-color="#eff1f4" />
      </linearGradient>
      <linearGradient id={`${id}-edge`} x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#dce0e6" /><stop offset="1" stop-color="#adb5c1" />
      </linearGradient>
      <filter id={`${id}-shadow`} x="-30%" y="-30%" width="170%" height="180%">
        <feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#515e73" flood-opacity=".12" />
      </filter>
    </defs>

    {feature === "gpu" && (
      <g transform="translate(214 160) rotate(-18)" filter={shadow}>
        <g stroke="#aeb6c2" stroke-width="7" stroke-linecap="round">
          <path d="M-62-91v-21m25 21v-21m25 21v-21m25 21v-21m25 21v-21m25 21v-21M-62 91v21m25-21v21m25-21v21m25-21v21m25-21v21m25-21v21" />
          <path d="M-91-62h-21m21 25h-21m21 25h-21m21 25h-21m21 25h-21m21 25h-21M91-62h21m-21 25h21m-21 25h21m-21 25h21m-21 25h21m-21 25h21" />
        </g>
        <rect x="-92" y="-86" width="184" height="184" rx="28" fill={edge} stroke="#adb5c1" />
        <rect x="-92" y="-94" width="184" height="184" rx="28" fill={silver} stroke="#fff" stroke-width="1.5" />
        <rect x="-68" y="-70" width="136" height="136" rx="18" fill={face} stroke="#b8c0cc" />
        <rect x="-63" y="-65" width="126" height="126" rx="14" stroke="#fff" />
        <path d="m15-40-46 48h27l-12 35L32-8H4l11-32Z" fill="#697585" />
        <path d="M-45 49h22m7 0h9" stroke="#c1c8d2" stroke-width="3" stroke-linecap="round" />
        <circle cx="48" cy="48" r="3" fill="#799bbc" />
      </g>
    )}

    {feature === "changes" && (
      <>
        <g transform="translate(12 7) rotate(-11 180 155)">
          <rect x="74" y="27" width="225" height="272" rx="22" fill="#dfe3e9" stroke="#c6cdd7" />
          <rect x="87" y="18" width="225" height="272" rx="22" fill={silver} stroke="#d1d7e0" />
        </g>
        <g transform="rotate(6 219 150)" filter={shadow}>
          <rect x="109" y="20" width="230" height="276" rx="23" fill={edge} />
          <rect x="109" y="15" width="230" height="276" rx="23" fill={face} stroke="#fff" stroke-width="1.5" />
          <path d="M135 45h13l7 7v19h-20V45Zm13 0v8h7" stroke="#929dab" stroke-width="2" stroke-linejoin="round" />
          <path d="M169 50h85m-85 13h53" stroke="#ced4dc" stroke-width="5" stroke-linecap="round" />
          <rect x="127" y="94" width="194" height="42" rx="9" fill="#f0dfdc" />
          <path d="M139 115h11" stroke="#ad7c73" stroke-width="2.5" stroke-linecap="round" />
          <path d="M167 115h94m9 0h22" stroke="#c39a92" stroke-width="5" stroke-linecap="round" />
          <rect x="127" y="145" width="194" height="93" rx="9" fill="#e1ede6" />
          <g stroke="#69947d" stroke-width="2.5" stroke-linecap="round">
            <path d="M139 168h11m-5.5-5.5v11M139 193h11m-5.5-5.5v11M139 218h11m-5.5-5.5v11" />
          </g>
          <path d="M167 168h64m10 0h44m-118 25h28m10 0h81m-119 25h85" stroke="#92b5a1" stroke-width="5" stroke-linecap="round" />
          <path d="M140 262h82m11 0h31" stroke="#d0d6de" stroke-width="4" stroke-linecap="round" />
        </g>
        <g transform="translate(319 241)" filter={shadow}>
          <circle cy="5" r="42" fill={edge} />
          <circle r="42" fill={silver} stroke="#fff" stroke-width="2" />
          <circle r="32" fill={face} stroke="#d0d7de" />
          <path d="m-15 0 10 10 21-22" stroke="#5d8b72" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )}

    {feature === "branches" && (
      <g transform="rotate(-12 200 155)">
        <path d="M133 290V77m0 158c0-69 145-31 145-106V56" stroke="#bcc4cf" stroke-width="15" stroke-linecap="round" />
        <path d="M130 290V77m0 155c0-69 145-31 145-106V56" stroke="#f9fafc" stroke-width="9" stroke-linecap="round" />
        <g filter={shadow}>
          <circle cx="132" cy="79" r="37" fill={silver} stroke="#fff" stroke-width="2" />
          <circle cx="277" cy="56" r="37" fill={silver} stroke="#fff" stroke-width="2" />
          <circle cx="132" cy="248" r="37" fill={silver} stroke="#fff" stroke-width="2" />
        </g>
        <circle cx="132" cy="79" r="18" fill={face} stroke="#c4ccd7" />
        <circle cx="277" cy="56" r="18" fill={face} stroke="#c4ccd7" />
        <circle cx="132" cy="248" r="18" fill="#dce6ef" stroke="#a2b7cd" />
        <circle cx="132" cy="248" r="7" fill="#718ea9" />
        <path d="M126 79h12m145-23h-12" stroke="#9ba7b7" stroke-width="3" stroke-linecap="round" />
      </g>
    )}

    {feature === "history" && (
      <>
        <path d="M0 139h400" stroke="#c4cbd6" stroke-width="3" />
        <g fill={face} stroke="#b7c0cd" stroke-width="2">
          <circle cx="32" cy="139" r="10" /><circle cx="103" cy="139" r="10" /><circle cx="339" cy="139" r="10" />
        </g>
        <g transform="rotate(-8 211 140)" filter={shadow}>
          <rect x="259" y="181" width="28" height="107" rx="14" transform="rotate(-43 273 195)" fill={silver} stroke="#b7c1ce" />
          <circle cx="211" cy="139" r="79" fill={silver} stroke="#fff" stroke-width="2" />
          <circle cx="211" cy="139" r="63" fill="#f7f8fa" stroke="#aeb9c7" stroke-width="2" />
          <path d="M150 139h122" stroke="#bbc8d7" stroke-width="3" />
          <circle cx="211" cy="139" r="20" fill={face} stroke="#819ab3" stroke-width="3" />
          <circle cx="211" cy="139" r="7" fill="#819ab3" />
          <path d="M162 118a52 52 0 0 1 59-30" stroke="#fff" stroke-width="6" stroke-linecap="round" />
        </g>
      </>
    )}

    {feature === "spaces" && (
      <>
        <g transform="translate(-19 29) rotate(-19 203 168)">
          <path d="M92 88a16 16 0 0 1 16-16h62l22 23h105a16 16 0 0 1 16 16v140a16 16 0 0 1-16 16H108a16 16 0 0 1-16-16V88Z" fill={silver} stroke="#c0c8d3" />
          <path d="M112 86h44" stroke="#91a8c3" stroke-width="5" stroke-linecap="round" />
        </g>
        <g transform="translate(25 -13) rotate(-3 203 168)">
          <path d="M92 88a16 16 0 0 1 16-16h62l22 23h105a16 16 0 0 1 16 16v140a16 16 0 0 1-16 16H108a16 16 0 0 1-16-16V88Z" fill={silver} stroke="#c0c8d3" />
          <path d="M112 86h44" stroke="#b4a3bd" stroke-width="5" stroke-linecap="round" />
        </g>
        <g transform="translate(57 28) rotate(12 203 168)" filter={shadow}>
          <path d="M92 88a16 16 0 0 1 16-16h62l22 23h105a16 16 0 0 1 16 16v140a16 16 0 0 1-16 16H108a16 16 0 0 1-16-16V88Z" fill={edge} stroke="#c0c8d3" />
          <rect x="92" y="105" width="221" height="158" rx="16" fill={face} stroke="#fff" />
          <path d="M112 86h44" stroke="#bda791" stroke-width="5" stroke-linecap="round" />
          <path d="m125 207 10 10-10 10m21 0h16" stroke="#9ca8b8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )}

    {feature === "remote" && (
      <>
        <path d="M126 201v41c0 23 142 23 142-9v-45" stroke="#bac3cf" stroke-width="9" stroke-linecap="round" />
        <path d="M124 201v41c0 20 142 20 142-9v-45" stroke="#fff" stroke-width="4" stroke-linecap="round" />
        <g transform="rotate(-9 126 140)" filter={shadow}>
          <rect x="27" y="77" width="188" height="130" rx="13" fill={edge} stroke="#aeb7c4" />
          <rect x="32" y="73" width="178" height="126" rx="10" fill={silver} stroke="#fff" />
          <rect x="42" y="83" width="158" height="103" rx="5" fill="#e9edf2" stroke="#c1cad6" />
          <path d="m77 119 14 14-14 14m28 0h20" stroke="#7c8a9e" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M17 202h210l11 13c2 3-2 6-6 6H13c-4 0-8-3-6-6l10-13Z" fill={silver} stroke="#b5becb" />
          <path d="M96 202h53l-4 5h-45l-4-5Z" fill="#b5becb" />
        </g>
        <g transform="rotate(9 296 128)" filter={shadow}>
          <rect x="246" y="53" width="108" height="150" rx="22" fill={edge} />
          <rect x="240" y="46" width="108" height="150" rx="22" fill={silver} stroke="#fff" stroke-width="1.5" />
          <rect x="253" y="61" width="82" height="120" rx="13" fill={face} stroke="#c8d0db" />
          <path d="M269 84h50m-50 12h50m-50 12h50" stroke="#c3cbd6" stroke-width="3" stroke-linecap="round" />
          <circle cx="294" cy="158" r="5" fill="#7a9a84" />
        </g>
      </>
    )}

    {feature === "cli" && (
      <>
        <g transform="rotate(-10 183 178)" filter={shadow}>
          <rect x="72" y="78" width="223" height="178" rx="30" fill={edge} stroke="#aeb8c5" />
          <rect x="72" y="70" width="223" height="178" rx="30" fill={silver} stroke="#fff" stroke-width="1.5" />
          <rect x="87" y="85" width="193" height="148" rx="19" fill={face} stroke="#bdc7d3" />
          <path d="m110 134 17 17-17 17" stroke="#8e9bac" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <text x="145" y="181" fill="#626f82" font-family="Menlo, monospace" font-size="65" font-weight="500" letter-spacing="-5">gh</text>
        </g>
        <g transform="rotate(10 302 117)" filter={shadow}>
          <rect x="260" y="79" width="91" height="91" rx="24" fill={edge} />
          <rect x="260" y="74" width="91" height="91" rx="24" fill={face} stroke="#fff" stroke-width="2" />
          <image href="/favicon.svg" x="279" y="92" width="53" height="53" />
        </g>
        <circle cx="330" cy="171" r="17" fill="#e2ece5" stroke="#fff" stroke-width="3" />
        <path d="m323 171 5 5 9-10" stroke="#63876e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )}

    {feature === "stash" && (
      <g transform="rotate(9 200 172)">
        <rect x="106" y="60" width="158" height="173" rx="17" transform="rotate(-16 185 146)" fill={silver} stroke="#c1cbd6" />
        <rect x="122" y="49" width="158" height="173" rx="17" transform="rotate(-5 201 135)" fill={face} stroke="#c8d1dc" />
        <path d="M150 78h49m-49 14h100m-100 14h80" stroke="#c2ccd7" stroke-width="5" stroke-linecap="round" />
        <g filter={shadow}>
          <path d="m101 164-23 42v63a16 16 0 0 0 16 16h212a16 16 0 0 0 16-16v-63l-23-42H101Z" fill={edge} stroke="#b9c3d0" />
          <path d="m101 164-23 42h73l15 22h68l15-22h73l-23-42H101Z" fill={silver} stroke="#fff" />
          <path d="M78 211h70l15 22h74l15-22h70v51a16 16 0 0 1-16 16H94a16 16 0 0 1-16-16v-51Z" fill={face} stroke="#d9dfe7" />
          <rect x="180" y="253" width="40" height="5" rx="2.5" fill="#aebbc9" />
        </g>
      </g>
    )}

    {feature === "keyboard" && (
      <g transform="translate(201 165) rotate(-14)" filter={shadow}>
        <rect x="-138" y="-58" width="126" height="136" rx="24" fill={edge} stroke="#b3bdcb" />
        <rect x="6" y="-58" width="126" height="136" rx="24" fill={edge} stroke="#b3bdcb" />
        <rect x="-138" y="-70" width="126" height="130" rx="24" fill={silver} stroke="#fff" stroke-width="1.5" />
        <rect x="6" y="-70" width="126" height="130" rx="24" fill={silver} stroke="#fff" stroke-width="1.5" />
        <rect x="-127" y="-59" width="104" height="106" rx="17" fill={face} stroke="#d9dfe7" />
        <rect x="17" y="-59" width="104" height="106" rx="17" fill={face} stroke="#d9dfe7" />
        <g fill="#768398" text-anchor="middle" font-size="55" font-weight="400">
          <text x="-75" y="16">⌘</text><text x="69" y="16">P</text>
        </g>
      </g>
    )}
  </svg>
</div>

<style>
  .feature-illustration { position: absolute; pointer-events: none; }
  .feature-illustration > svg { display: block; width: 100%; height: 100%; overflow: visible; }
</style>
