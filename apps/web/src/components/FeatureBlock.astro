---
import AppWindow from "./AppWindow.astro";
import TabStrip from "./TabStrip.astro";
import AiComposer from "./AiComposer.astro";
interface Props { variant: "native" | "tabs" | "ai" }
const { variant } = Astro.props;
---
<article class:list={["feature-block", `feature-${variant}`]} data-reveal data-glow-zone="section">
  <div class="feature-copy">
    <p class="section-label">{variant === "native" ? "01 / A focused workspace" : variant === "tabs" ? "02 / In your flow" : "03 / A little assistance"}</p>
    {variant === "native" && <><h3>Native speed.<br />GPU rendered.</h3><p>Smooth at any size, from one file to thousands.</p></>}
    {variant === "tabs" && <><h3>Every repository.<br />A tab of its own.</h3><p>Drag, reorder, switch with ⌘P.</p></>}
    {variant === "ai" && <><h3>AI commit drafts.<br />Yours to refine.</h3><p>Review the suggestion. Make it yours.</p><p class="demo-caption">AI is optional. Drafts stay editable.</p></>}
  </div>
  <div class="feature-art">
    {variant === "native" && <AppWindow name="changes" alt="Native Changes workspace showing the file list, README diff and commit controls." />}
    {variant === "tabs" && <>
      <p class="tabs-word display"><span class="sr-only">Tabs</span><span aria-hidden="true">Ta{[0,1,2,3,4,5].map((i) => <span class="extra-a" style={`--order:${i}`}>a</span>)}bs</span></p>
      <TabStrip />
    </>}
    {variant === "ai" && <AiComposer />}
  </div>
</article>
