---
interface Props { variant?: "hero" | "section" | "deep" }
const { variant = "section" } = Astro.props;
---

<div class="glow-background" data-glow-background data-variant={variant} aria-hidden="true">
  <canvas data-glow-canvas></canvas>
  <div class="static-grain"></div>
  <div class="glow-readability"></div>
</div>

<script>
  import "../scripts/glow";
</script>
