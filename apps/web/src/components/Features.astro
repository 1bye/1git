---
import FeatureBlock from "./FeatureBlock.astro";
import ConnectionLines from "./ConnectionLines.astro";
import ThemeCycler from "./ThemeCycler.astro";
import EvenMoreGrid from "./EvenMoreGrid.astro";
---
<section id="features" class="features" aria-labelledby="features-title" data-glow-zone="section">
  <div class="section-intro">
    <p class="section-label">Built for the way you work</p>
    <h2 id="features-title">Everything in its place.</h2>
    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>Pause motion</button>
  </div>
  <FeatureBlock variant="native" />
  <FeatureBlock variant="tabs" />
  <FeatureBlock variant="ai" />
  <ConnectionLines />
  <ThemeCycler />
  <EvenMoreGrid />
</section>
