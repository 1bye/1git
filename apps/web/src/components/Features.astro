---
import FeatureIllustration from "./FeatureIllustration.astro";

const features = [
  { id: "gpu", title: ["Native speed.", "GPU rendered."] },
  { id: "changes", title: ["Review. Stage.", "Commit."] },
  { id: "branches", title: ["Branches and", "worktrees."] },
  { id: "history", title: ["History.", "In focus."] },
  { id: "spaces", title: ["A space for", "every project."] },
  { id: "remote", title: ["Local or SSH.", "One workspace."] },
  { id: "cli", title: ["Sign in with", "GitHub CLI."] },
  { id: "stash", title: ["Stash it.", "Keep your flow."] },
  { id: "keyboard", title: ["Made for", "your keyboard."] },
] as const;
---

<section id="features" class="features" aria-labelledby="features-title">
  <div class="section-intro">
    <h2 id="features-title">Everything in its place.</h2>
  </div>
  <div class="bento">
    {features.map(({ id, title }) => (
      <article class:list={["feature-card", `card-${id}`]}>
        <div class="feature-copy">
          <h3>{title[0]}<br />{title[1]}</h3>
        </div>
        <FeatureIllustration feature={id} />
      </article>
    ))}
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: 190px 210px 230px 190px;
    grid-template-areas:
      "gpu gpu changes changes"
      "branches history changes changes"
      "spaces spaces remote cli"
      "stash keyboard keyboard keyboard";
    gap: 18px;
  }
  .feature-card { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; border-radius: 24px; background: #f5f5f7; }
  .feature-copy { position: relative; z-index: 1; flex-shrink: 0; padding: 24px 24px 0; }
  .feature-copy h3 { margin: 0; color: #1d1d1f; font-size: 24px; font-weight: 600; line-height: 1.1; letter-spacing: -.04em; }
  .card-gpu { grid-area: gpu; }
  .card-changes { grid-area: changes; }
  .card-branches { grid-area: branches; }
  .card-history { grid-area: history; }
  .card-spaces { grid-area: spaces; }
  .card-remote { grid-area: remote; }
  .card-cli { grid-area: cli; }
  .card-stash { grid-area: stash; }
  .card-keyboard { grid-area: keyboard; }
  .card-gpu, .card-spaces, .card-keyboard { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; }
  .card-gpu .feature-copy, .card-spaces .feature-copy, .card-keyboard .feature-copy { padding: 26px 0 26px 28px; }
  .card-gpu h3 { font-size: 29px; }
  .card-gpu :global(.feature-illustration) { height: 100%; padding: 8px 4px; }
  .card-gpu :global(svg) { max-width: 300px; }
  .card-changes { flex-direction: column-reverse; }
  .card-changes .feature-copy { padding: 0 30px 28px; }
  .card-changes h3 { font-size: 32px; }
  .card-changes :global(.feature-illustration) { padding: 6px 0 0; }
  .card-spaces :global(.feature-illustration) { height: 100%; padding: 0; }
  .card-spaces :global(svg) { width: 120%; flex-shrink: 0; }
  .card-keyboard { grid-template-columns: 1fr 1fr; }
  .card-keyboard .feature-copy { order: 2; padding-left: 0; }
  .card-keyboard h3 { font-size: 28px; }
  .card-keyboard :global(.feature-illustration) { order: 1; height: 100%; padding: 0; }
  .card-keyboard :global(svg) { max-width: 320px; }
  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 180px 200px 200px 190px 230px 230px;
      grid-template-areas:
        "gpu gpu"
        "changes branches"
        "changes history"
        "spaces spaces"
        "remote cli"
        "stash keyboard";
    }
    .card-gpu, .card-spaces { grid-template-columns: 1fr 1fr; }
    .card-gpu h3 { font-size: 30px; }
    .card-spaces :global(svg) { width: 100%; max-width: 350px; }
    .card-keyboard { display: flex; flex-direction: column; align-items: stretch; }
    .card-keyboard .feature-copy { order: 0; padding: 24px 24px 0; }
    .card-keyboard h3 { font-size: 24px; }
    .card-keyboard :global(.feature-illustration) { height: auto; padding: 10px 12px 14px; }
  }
  @media (max-width: 580px) {
    .bento { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: none; gap: 14px; }
    .feature-card { grid-area: auto; display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: 160px; border-radius: 22px; }
    .feature-card .feature-copy { order: 0; padding: 22px 0 22px 22px; }
    .feature-card h3 { font-size: 22px; }
    .feature-card :global(.feature-illustration) { height: auto; padding: 0 10px 0 0; }
    .feature-card :global(svg) { width: 210px; max-width: none; flex-shrink: 0; }
    .card-changes { display: flex; flex-direction: column-reverse; height: 290px; }
    .card-changes .feature-copy { align-self: stretch; padding: 0 26px 24px; }
    .card-changes h3 { font-size: 28px; }
    .card-changes :global(.feature-illustration) { width: 100%; min-height: 0; padding: 0; }
    .card-changes :global(svg) { width: 100%; height: 100%; }
    .card-spaces .feature-copy, .card-keyboard .feature-copy { order: 2; padding: 22px 22px 22px 0; }
    .card-spaces :global(.feature-illustration), .card-keyboard :global(.feature-illustration) { order: 1; padding: 0; }
  }
</style>
