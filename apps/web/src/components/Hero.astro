---
import AppWindow from "./AppWindow.astro";
import WindowClouds from "./WindowClouds.astro";
// Incremental Gaussian radii combine into a smooth ramp capped at 30px.
const blurSteps = [2, 5, 8, 12, 16, 20, 25, 30];
---
<section id="top" class="hero" aria-labelledby="hero-title" data-scene="intro">
  <div class="hero-copy" data-glow-anchor>
    <div class="wordmark-scene">
      <p class="hero-wordmark display">1git</p>
    </div>
    <h1 id="hero-title" class="display">A clearer view.<br />Of every change.</h1>
    <div class="cta-row">
      <a class="download-button" href="https://git.1bye.dev/download">Download for macOS <span aria-hidden="true">↗</span></a>
    </div>
    <p class="download-note">macOS 13+ · Apple Silicon · Git required</p>
  </div>
  <div class="hero-window-stage">
    <div class="hero-product">
      <AppWindow name="changes" alt="Changes view with checked files, a README diff and commit composer in the hero." eager progressive />
    </div>
    <div class="hero-clouds"><WindowClouds /></div>
    <div class="hero-linear-blur" aria-hidden="true">
      {blurSteps.map((target,i) => {
        const previous = blurSteps[i-1] ?? 0;
        const radius = Math.sqrt(target * target - previous * previous);
        return <span class="blur-slice" style={`--blur:${radius.toFixed(2)}px;--from:${47+i*5}%;--peak:${52+i*5}%`} />;
      })}
    </div>
  </div>
</section>
