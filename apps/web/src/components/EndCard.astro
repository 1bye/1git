---
import { REPO_URL } from "./repository-link";
import ButtonHover from "./ButtonHover.astro";
---
<footer class="end-card" data-reveal data-scene="end">
  <div class="scene-content" data-scene-motion>
  <div data-scene-text><p class="end-wordmark display">1git</p></div>
  <p class="end-tagline" data-scene-text style="--scene-delay:120ms">Every repository. One window.</p>
  <div class="cta-row" data-scene-text style="--scene-delay:240ms">
    <a class="download-button" href="https://git.1bye.dev/download">Download for macOS <ButtonHover kind="download" /></a>
  </div>
  <div class="footer-meta" data-scene-text style="--scene-delay:360ms">
    <div class="footer-links"><span>Made by <a href="https://1bye.dev">1bye</a>.</span><a href="/faq/">Questions &amp; answers</a><a href={REPO_URL} target="_blank" rel="noopener" aria-label="GitHub repository, opens in a new tab">GitHub <span aria-hidden="true">↗</span></a></div>
    <p>macOS 13+ · Apple Silicon · Git required</p>
  </div>
  </div>
</footer>
