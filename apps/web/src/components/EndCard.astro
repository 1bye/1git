---
import { REPO_URL } from "./repository-link";
import AnalyticsPreference from "./AnalyticsPreference.astro";
---
<footer class="end-card" data-reveal data-scene="end">
  <div class="scene-content" data-scene-motion>
  <p class="end-wordmark display">1git</p>
  <p class="end-tagline">Every repository. One window.</p>
  <a class="download-button" href="https://git.1bye.dev/download">Download for macOS <span aria-hidden="true">↗</span></a>
  <div class="footer-meta">
    <div class="footer-links"><span>Made by <a href="https://1bye.dev">1bye</a>.</span><a href="/faq/">Questions &amp; answers</a><a href={REPO_URL} target="_blank" rel="noopener" aria-label="GitHub repository, opens in a new tab">GitHub <span aria-hidden="true">↗</span></a><button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>Pause animations</button></div>
    <AnalyticsPreference />
    <p>macOS 13+ · Apple Silicon · Git required</p>
  </div>
  </div>
</footer>
