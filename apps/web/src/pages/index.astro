---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ButtonHover from "../components/ButtonHover.astro";
import EndCard from "../components/EndCard.astro";
import workspaceScreenshot from "../assets/screens/changes.webp";
import { REPO_URL } from "../components/repository-link";
import Features from "../components/Features.astro";
import "../styles/scenes.css";

const application = {
  "@type": "SoftwareApplication",
  "@id": new URL("/#app", Astro.site).href,
  name: "1git",
  url: Astro.site?.href,
  description: "A native Git client for macOS. Review changes, stage files, manage branches and worktrees, and work with local or SSH repositories in separate spaces and tabs.",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 13 or later",
  processorRequirements: "Apple Silicon",
  softwareRequirements: "Git",
  downloadUrl: new URL("/download", Astro.site).href,
  screenshot: new URL(workspaceScreenshot.src, Astro.site).href,
  image: new URL("/og.png", Astro.site).href,
  author: { "@id": "https://1bye.dev/#person" },
  sameAs: REPO_URL,
  featureList: [
    "Native GPU-rendered interface", "Review changes and commit selected files",
    "Branches and worktrees", "Spaces and repository tabs", "Commit history",
    "GitHub and GitLab accounts", "GitHub CLI sign-in", "Local and SSH repositories",
    "Optional AI commit drafts", "Opt-in ignored-file history", "Multiple stashes",
    "Editors by file type", "Keyboard shortcuts",
  ],
};
---

<Layout structuredData={application}>
  <header class="site-header" inert>
    <div class="site-header-content">
      <a class="brand" href="#top" aria-label="1git home"><span>1git</span></a>
      <nav aria-label="Main navigation"><a href="#features">Explore</a><a href="/faq/">FAQ</a><a class="header-download" href="https://git.1bye.dev/download">Download <ButtonHover kind="download" /></a></nav>
    </div>
  </header>
  <main id="main">
    <Hero />
    <Features />
  </main>
  <EndCard />
</Layout>

<script>
  import "../scripts/site-header";
  import { initMotion } from "../scripts/motion";
  import { initFeatures } from "../scripts/launch-features";
  import { initScenes } from "../scripts/scene-motion";
  initMotion();
  initScenes();
  initFeatures();
</script>
