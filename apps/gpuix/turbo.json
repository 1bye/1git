{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build", "build:native"],
      "passThroughEnv": [
        "GPUIX_BACKGROUND",
        "GPUIX_PREVIEW",
        "ONEGIT_LAUNCHER_CWD"
      ]
    },
    "build:native": {
      "cache": false,
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "DEVELOPER_DIR"]
    },
    "test": { "cache": false },
    "test:signing:macos": { "dependsOn": ["^build", "build:native"] },
    "check-types": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false }
  }
}
