+
+// Yield to the host between frames so display callbacks cannot starve JavaScript input.
+pub(crate) fn claim_embedded_frame(view: usize) -> bool {
+    !EMBEDDED_PUMP_ACTIVE.get()
+        || EMBEDDED_FRAME_VIEWS.with_borrow_mut(|views| views.insert(view))
+}

