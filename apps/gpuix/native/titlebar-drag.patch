+    // Window moves must begin synchronously while AppKit's mouse event is current.
+    if element
+        .custom_props
+        .get("windowDrag")
+        .and_then(|value| value.as_bool())
+        == Some(true)
+    {
+        el = el.on_mouse_down(gpui::MouseButton::Left, |event, window, cx| {
+            cx.stop_propagation();
+            if event.click_count == 2 {
+                window.zoom_window();
+            } else {
+                window.start_window_move();
+            }
+        });
+    }
+
