 use objc::runtime::{BOOL, YES};
 use raw_window_handle::{HasWindowHandle, RawWindowHandle};
 use std::ffi::CStr;
+
+/// Read the application's effective appearance independently of window overrides.
+pub fn system_appearance() -> gpui::WindowAppearance {
+    unsafe {
+        let app: id = msg_send![class!(NSApplication), sharedApplication];
+        let appearance: id = msg_send![app, effectiveAppearance];
+        let names: id = msg_send![class!(NSArray), arrayWithObjects: [NSAppearanceNameAqua, NSAppearanceNameDarkAqua].as_ptr() count: 2_usize];
+        let name: id = msg_send![appearance, bestMatchFromAppearancesWithNames: names];
+        if name == NSAppearanceNameDarkAqua { gpui::WindowAppearance::Dark } else { gpui::WindowAppearance::Light }
+    }
+}
 
