+/// Native pixel range and viewport for ordinary scroll handles and virtual lists.
+pub(crate) fn scroll_metrics(id: u64, horizontal: bool) -> Option<Vec<f64>> {
+    if !horizontal {
+        if let Some(state) = VIRTUAL_LIST_STATES.with(|states| states.borrow().get(&id).cloned()) {
+            let bounds = state.viewport_bounds();
+            return Some(vec![f32::from(state.scroll_px_offset_for_scrollbar().y) as f64,
+                f32::from(state.max_offset_for_scrollbar().y) as f64,
+                f32::from(bounds.origin.x) as f64, f32::from(bounds.origin.y) as f64,
+                f32::from(bounds.size.width) as f64, f32::from(bounds.size.height) as f64]);
+        }
+    }
+    SCROLL_HANDLES.with(|handles| handles.borrow().get(&id).map(|handle| {
+        let mut bounds = handle.bounds();
+        // Split diff handles belong to individual rows; the virtual list owns the pane's vertical viewport.
+        if horizontal {
+            if let Some(state) = VIRTUAL_LIST_STATES.with(|states| states.borrow().get(&id).cloned()) {
+                let viewport = state.viewport_bounds();
+                bounds.origin.y = viewport.origin.y;
+                bounds.size.height = viewport.size.height;
+            }
+        }
+        let offset = handle.offset();
+        let max = handle.max_offset();
+        vec![f32::from(if horizontal { offset.x } else { offset.y }) as f64,
+            f32::from(if horizontal { max.x } else { max.y }) as f64,
+            f32::from(bounds.origin.x) as f64, f32::from(bounds.origin.y) as f64,
+            f32::from(bounds.size.width) as f64, f32::from(bounds.size.height) as f64]
+    }))
+}
