+/// Autorelease boundary for native test calls made outside NSApplication::run.
+#[cfg(any(test, feature = "test-support"))]
+pub struct TestAutoreleasePool(id);
+
+#[cfg(any(test, feature = "test-support"))]
+impl TestAutoreleasePool {
+    pub fn new() -> Self {
+        assert_main_thread("TestAutoreleasePool::new");
+        Self(unsafe { NSAutoreleasePool::new(nil) })
+    }
+}
+
+#[cfg(any(test, feature = "test-support"))]
+impl Drop for TestAutoreleasePool {
+    fn drop(&mut self) {
+        unsafe { self.0.drain(); }
+    }
+}
+
+/// Finish AppKit's pending close work while the test App is still alive.
+#[cfg(any(test, feature = "test-support"))]
+pub fn drain_test_events() {
+    assert_main_thread("drain_test_events");
+    let _pool = TestAutoreleasePool::new();
+    unsafe { CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.005, 0); }
+}
