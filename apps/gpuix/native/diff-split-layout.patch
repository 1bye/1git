 const SELECTION_SCROLL_TICK_MS: u64 = 24;
+
+/// Fixed diff panes own X while their shared virtual list owns Y.
+fn set_pixel_scroll_offset(id: u64, x: f32, y: f32) {
+    let list = VIRTUAL_LIST_STATES.with(|states| states.borrow().get(&id).cloned());
+    if let Some(state) = &list {
+        state.set_offset_from_scrollbar(gpui::point(gpui::px(0.0), gpui::px(y)));
+    }
+    SCROLL_HANDLES.with(|handles| {
+        if let Some(handle) = handles.borrow().get(&id) {
+            handle.set_offset(gpui::point(gpui::px(x), gpui::px(if list.is_some() { 0.0 } else { y })));
+        }
+    });
+}
+
+fn pixel_scroll_offset(id: u64) -> Option<[f64; 2]> {
+    let list = VIRTUAL_LIST_STATES.with(|states| {
+        states.borrow().get(&id).map(|state| state.scroll_px_offset_for_scrollbar())
+    });
+    let handle = SCROLL_HANDLES.with(|handles| {
+        handles.borrow().get(&id).map(|handle| handle.offset())
+    });
+    let offset = handle.or(list)?;
+    Some([
+        f64::from(f32::from(offset.x)),
+        f64::from(f32::from(list.map_or(offset.y, |list| list.y))),
+    ])
+}
 const SELECTION_SCROLL_EDGE_PX: f32 = 36.0;
 const SELECTION_SCROLL_MAX_STEP_PX: f32 = 24.0;
 
