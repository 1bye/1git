+
+
+/// Keep the complete menu in the owning view when it fits; AppKit handles oversized menus.
+fn menu_origin(x: f64, y: f64, width: f64, height: f64, view_width: f64, view_height: f64) -> (f64, f64) {
+    (x.clamp(0.0, (view_width - width).max(0.0)), y.clamp(0.0, (view_height - height).max(0.0)))
+}
+
+#[cfg(test)]
+mod menu_placement_tests {
+    use super::menu_origin;
+
+    #[test]
+    fn opens_bottom_menus_fully_above_the_window_edge() {
+        assert_eq!(menu_origin(40.0, 600.0, 240.0, 280.0, 980.0, 640.0), (40.0, 360.0));
+        assert_eq!(menu_origin(40.0, 50.0, 240.0, 280.0, 980.0, 640.0), (40.0, 50.0));
+        assert_eq!(menu_origin(970.0, 600.0, 240.0, 280.0, 980.0, 640.0), (740.0, 360.0));
+        assert_eq!(menu_origin(40.0, 600.0, 1200.0, 800.0, 980.0, 640.0), (0.0, 0.0));
+    }
+}
