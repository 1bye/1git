+thread_local! {
+    // AppKit owns the small copies and may evict them under memory pressure.
+    static APPLICATION_MENU_ICONS: objc::rc::StrongPtr = unsafe {
+        let cache: id = msg_send![class!(NSCache), new];
+        let _: () = msg_send![cache, setCountLimit: 64_usize];
+        objc::rc::StrongPtr::new(cache)
+    };
+}
+
+/// Only application bundles can supply decorative icons; never interpret URLs or executable commands.
+fn application_menu_icon(path: &str) -> id {
+    let application = std::path::Path::new(path);
+    if path.is_empty() || path.len() > 4096 || path.contains(['\0', '\r', '\n'])
+        || !application.is_absolute()
+        || !application.extension().is_some_and(|extension| extension.eq_ignore_ascii_case("app"))
+        || application.components().any(|part| matches!(part, std::path::Component::ParentDir | std::path::Component::CurDir))
+    {
+        return nil;
+    }
+    APPLICATION_MENU_ICONS.with(|cache| unsafe {
+        let key = crate::ns_string(path);
+        let cached: id = msg_send![**cache, objectForKey: key];
+        if cached != nil { return cached; }
+        if !std::fs::metadata(application).is_ok_and(|metadata| metadata.is_dir()) { return nil; }
+        let workspace: id = msg_send![class!(NSWorkspace), sharedWorkspace];
+        let source: id = msg_send![workspace, iconForFile: key];
+        if source == nil { return nil; }
+        // Never resize the image shared by LaunchServices or another menu.
+        let image: id = msg_send![source, copy];
+        let _: () = msg_send![image, setSize: NSSize::new(16.0, 16.0)];
+        let _: () = msg_send![**cache, setObject: image forKey: key];
+        let _: id = msg_send![image, autorelease];
+        image
+    })
+}
+
+fn set_application_menu_icon(item: id, path: &str) {
+    unsafe {
+        let _: () = msg_send![item, setImage: application_menu_icon(path)];
+    }
+}
+
+/// Inspect real NSMenuItem image sizes without entering AppKit's blocking menu tracking loop.
+#[cfg(any(test, feature = "test-support"))]
+pub fn context_menu_icon_sizes(paths: &[String]) -> anyhow::Result<Vec<f64>> {
+    anyhow::ensure!(paths.len() <= 128, "Too many menu icons");
+    unsafe {
+        let main_thread: BOOL = msg_send![class!(NSThread), isMainThread];
+        anyhow::ensure!(main_thread == YES, "Menu icons require the main thread");
+        let _pool = crate::TestAutoreleasePool::new();
+        let mut sizes = Vec::with_capacity(paths.len() * 2);
+        for path in paths {
+            let item: id = msg_send![class!(NSMenuItem), new];
+            set_application_menu_icon(item, path);
+            let image: id = msg_send![item, image];
+            let size = if image == nil { NSSize::new(0.0, 0.0) } else { msg_send![image, size] };
+            sizes.extend([size.width, size.height]);
+            let _: () = msg_send![item, release];
+        }
+        Ok(sizes)
+    }
+}
