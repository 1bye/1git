+    /// Clips child painting to a rounded overflow surface without changing GPU buffer layouts.
+    pub fn with_rounded_content_mask<R>(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        radii: Corners<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint();
+        let scale = self.scale_factor();
+        self.next_frame
+            .scene
+            .push_rounded_mask(bounds.scale(scale), radii.scale(scale));
+        let result = f(self);
+        self.next_frame.scene.pop_rounded_mask();
+        result
+    }
