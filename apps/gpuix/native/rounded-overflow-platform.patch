+#[derive(Clone, Copy)]
+struct RoundedMask {
+    bounds: Bounds<ScaledPixels>,
+    radii: Corners<ScaledPixels>,
+}
+
+impl RoundedMask {
+    fn intersects_corner(&self, bounds: Bounds<ScaledPixels>) -> bool {
+        let left = bounds.left() - self.bounds.left();
+        let right = self.bounds.right() - bounds.right();
+        let top = bounds.top() - self.bounds.top();
+        let bottom = self.bounds.bottom() - bounds.bottom();
+        (top < self.radii.top_left && left < self.radii.top_left)
+            || (top < self.radii.top_right && right < self.radii.top_right)
+            || (bottom < self.radii.bottom_left && left < self.radii.bottom_left)
+            || (bottom < self.radii.bottom_right && right < self.radii.bottom_right)
+    }
+}
+
+fn corner_inset(radius: ScaledPixels, distance: f32) -> f32 {
+    let radius = radius.as_f32();
+    if distance >= radius || radius <= 0. {
+        return 0.;
+    }
+    radius
+        - (radius * radius - (radius - distance).powi(2))
+            .max(0.)
+            .sqrt()
+}
