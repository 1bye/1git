+
+/// Notify windowed JS rows after a native scrollbar changes the logical anchor.
+pub(crate) fn notify_virtual_list_scroll(id: u64, callback: &Option<EventCallback>) {
+    let index = VIRTUAL_LIST_STATES.with(|states| {
+        states.borrow().get(&id).map(|state| state.logical_scroll_top().item_ix)
+    });
+    if let Some(index) = index {
+        emit_event_full(callback, id, "visibleRange", |payload| {
+            payload.start_index = Some(index as f64);
+            payload.end_index = Some((index + 1) as f64);
+        });
+    }
 }
 
