--- /dev/null
+++ b/packages/native/src/credentials.rs
@@ -0,0 +1,42 @@
+//! Application-scoped OS credential storage. No plaintext fallback or raw platform errors.
+use napi::{bindgen_prelude::*, JsDeferred};
+
+pub(crate) type Deferred = JsDeferred<Option<Buffer>, Box<dyn FnOnce(Env) -> Result<Option<Buffer>> + Send>>;
+
+pub(crate) enum Operation {
+    Read(String),
+    Write(String, Vec<u8>),
+    Delete(String),
+}
+
+pub(crate) fn validate_key(key: &str) -> Result<()> {
+    let suffix = key.strip_prefix("1git-hosting-v1:").unwrap_or("");
+    if suffix.len() != 64 || !suffix.bytes().all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
+        return Err(Error::from_reason("Invalid application credential key"));
+    }
+    Ok(())
+}
+
+pub(crate) fn start(operation: Operation, cx: &mut gpui::App, deferred: Deferred) {
+    let executor = cx.background_executor().clone();
+    let task = match operation {
+        Operation::Read(key) => {
+            let task = cx.read_credentials(&key);
+            executor.spawn(async move { task.await.map(|entry| entry.map(|(_, bytes)| bytes)) })
+        }
+        Operation::Write(key, bytes) => {
+            let task = cx.write_credentials(&key, "1git", &bytes);
+            executor.spawn(async move { task.await.map(|()| None) })
+        }
+        Operation::Delete(key) => {
+            let task = cx.delete_credentials(&key);
+            executor.spawn(async move { task.await.map(|()| None) })
+        }
+    };
+    executor.spawn(async move {
+        match task.await {
+            Ok(bytes) => deferred.resolve(Box::new(move |_| Ok(bytes.map(Buffer::from)))),
+            Err(_) => deferred.reject(Error::from_reason("OS credential store is unavailable or access was denied")),
+        }
+    }).detach();
+}
