+/// Resolve the owning GPUI view, not NSApplication's transient key window.
+pub fn context_menu_view(window: &gpui::Window) -> anyhow::Result<usize> {
+    let handle = HasWindowHandle::window_handle(window)
+        .map_err(|error| anyhow::anyhow!("Could not access the GPUI view: {error}"))?;
+    match handle.as_raw() {
+        RawWindowHandle::AppKit(handle) => Ok(handle.ns_view.as_ptr() as usize),
+        _ => anyhow::bail!("Context menus require an AppKit view"),
+    }
