+#[cfg(target_os = "macos")]
+#[derive(Clone, Default)]
+struct CloseProtection(Arc<Mutex<(bool, bool)>>);
+
+#[cfg(target_os = "macos")]
+impl gpui::Global for CloseProtection {}
+
+#[cfg(target_os = "macos")]
+impl CloseProtection {
+    fn allow_close(&self) -> bool {
+        let mut state = self.0.lock().unwrap();
+        if state.0 { state.1 = true; }
+        !state.0
+    }
+}
