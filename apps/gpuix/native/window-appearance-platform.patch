+use objc::{class, msg_send, sel, sel_impl};
+use objc::runtime::{BOOL, YES};
+use raw_window_handle::{HasWindowHandle, RawWindowHandle};
 use std::ffi::CStr;
 
+/// Set only the owning NSWindow; its Sidebar material inherits the chosen appearance.
+pub fn set_window_appearance(window: &gpui::Window, dark: bool) -> anyhow::Result<()> {
+    let handle = HasWindowHandle::window_handle(window)
+        .map_err(|error| anyhow::anyhow!("Could not access the GPUI view: {error}"))?;
+    let RawWindowHandle::AppKit(handle) = handle.as_raw() else {
+        anyhow::bail!("Window appearance requires an AppKit view");
+    };
+    unsafe {
+        let main_thread: BOOL = msg_send![class!(NSThread), isMainThread];
+        anyhow::ensure!(main_thread == YES, "Window appearance requires the main thread");
+        let view = handle.ns_view.as_ptr() as id;
+        let native_window: id = msg_send![view, window];
+        anyhow::ensure!(!native_window.is_null(), "Window has closed");
+        let name = if dark { NSAppearanceNameDarkAqua } else { NSAppearanceNameAqua };
+        let appearance: id = msg_send![class!(NSAppearance), appearanceNamed: name];
+        anyhow::ensure!(!appearance.is_null(), "Native window appearance is unavailable");
+        let _: () = msg_send![native_window, setAppearance: appearance];
+    }
+    Ok(())
+}
