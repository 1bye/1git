+/// Pair adjacent deletion/addition runs without crossing a hunk or losing metadata.
+pub fn split_rows(files: &[FileDiff], rows: Vec<DiffRow>) -> Vec<DiffRow> {
+    let mut result = Vec::with_capacity(rows.len());
+    let mut index = 0;
+    while index < rows.len() {
+        let DiffRow::Line { file, hunk, line } = rows[index] else {
+            result.push(rows[index]);
+            index += 1;
+            continue;
+        };
+        let lines = &files[file as usize].hunks[hunk as usize].lines;
+        match lines[line as usize].kind {
+            LineKind::Context => {
+                result.push(DiffRow::SplitLine { file, hunk, old: Some(line), new: Some(line) });
+                index += 1;
+            }
+            LineKind::Meta => {
+                result.push(rows[index]);
+                index += 1;
+            }
+            _ => {
+                let mut old = Vec::new();
+                let mut new = Vec::new();
+                while let Some(DiffRow::Line { file: f, hunk: h, line: l }) = rows.get(index) {
+                    if *f != file || *h != hunk { break; }
+                    match lines[*l as usize].kind {
+                        LineKind::Del => old.push(*l),
+                        LineKind::Add => new.push(*l),
+                        _ => break,
+                    }
+                    index += 1;
+                }
+                for pair in 0..old.len().max(new.len()) {
+                    result.push(DiffRow::SplitLine { file, hunk, old: old.get(pair).copied(), new: new.get(pair).copied() });
+                }
+            }
+        }
+    }
+    result
+}
