+fn change_groups(files: &[FileDiff]) -> HashMap<String, Rc<Vec<String>>> {
+    // Selection is intentionally a single-file API. Coordinates stay stable
+    // when context is expanded or the viewer switches between split/unified.
+    let mut groups = HashMap::new();
+    if files.len() != 1 { return groups; }
+    for hunk in &files[0].hunks {
+        let mut pending = Vec::new();
+        let flush = |pending: &mut Vec<String>, groups: &mut HashMap<String, Rc<Vec<String>>>| {
+            if pending.is_empty() { return; }
+            let group = Rc::new(std::mem::take(pending));
+            for key in group.iter() { groups.insert(key.clone(), group.clone()); }
+        };
+        for line in &hunk.lines {
+            if let Some(key) = line_key(line) { pending.push(key); }
+            else if line.kind != LineKind::Meta { flush(&mut pending, &mut groups); }
+        }
+        flush(&mut pending, &mut groups);
+    }
+    groups
 }
 
