+fn line_key(line: &DiffLine) -> Option<String> {
+    match line.kind {
+        LineKind::Del => line.old_no.map(|n| format!("-:{n}")),
+        LineKind::Add => line.new_no.map(|n| format!("+:{n}")),
+        _ => None,
+    }
+}
