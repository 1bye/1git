+/// Native hit targets, not React row overlays: the virtual list remains the
+/// sole vertical scroller, and selection changes reuse the parsed/highlighted data.
+fn inclusion_cell(key: Option<&str>, group: bool, ix: usize, ctx: &RowContext, theme: &Theme) -> gpui::AnyElement {
+    use gpui::prelude::*;
+    let m = &theme.metrics;
+    let blank = || gpui::div().w(px(m.diff_marker_width)).h_full().flex_none()
+        .bg(if group { theme.border } else { theme.bg }).into_any_element();
+    let Some(key) = key else { return blank(); };
+    let Some(state) = ctx.inclusion else { return blank(); };
+    let Some((change_group, count)) = state.groups.get(key) else { return blank(); };
+    let keys = &change_group.keys;
+    let first = &keys[0];
+    let checked = if group { *count == keys.len() } else { state.included.contains(key) };
+    let mixed = group && *count > 0 && *count < keys.len();
+    let first_row = !group || key == first;
+    let focus_key = if group { format!("group:{first}") } else { key.to_string() };
+    let focus = state.focus[&focus_key].clone();
+    let value = if group { change_group.value.clone() } else { serde_json::to_string(&[key]).ok().map(Rc::new) };
+    let callback = ctx.callback.clone();
+    let keyboard_callback = callback.clone();
+    let keyboard_value = value.clone();
+    let element_id = ctx.element_id;
+    let mut selected_bg = theme.accent;
+    if group { selected_bg.l *= 0.8; }
+    let mut hover_bg = selected_bg;
+    hover_bg.l *= 0.9;
+    let mut cell = gpui::div()
+        .id(SharedString::from(format!("__gpuix_diff_include_{element_id}_{ix}_{group}")))
+        .w(px(m.diff_marker_width)).h_full().flex_none().flex().items_center().justify_center()
+        .block_mouse_except_scroll()
+        .bg(if checked || mixed { selected_bg } else if group { theme.border } else { theme.bg })
+        .text_color(if checked || mixed { theme.bg } else { theme.text_faint })
+        .role(gpui::Role::CheckBox)
+        .aria_label(SharedString::from(if group { format!("Include change group starting at {first}") } else { format!("Include changed line {key}") }))
+        .aria_toggled(if mixed { gpui::Toggled::Mixed } else if checked { gpui::Toggled::True } else { gpui::Toggled::False });
+    if !state.disabled {
+        let click_focus = focus.clone();
+        cell = cell.cursor_pointer()
+            .hover(|style| style.bg(if checked || mixed { hover_bg } else { opacity(theme.accent, 0.16) }))
+            .on_click(move |_, window, cx| {
+            cx.stop_propagation();
+            window.focus(&click_focus, cx);
+            emit_event_full(&callback, element_id, "toggleChange", |p| p.value = value.as_deref().cloned());
+        });
+        if first_row {
+            cell = cell.track_focus(&focus).tab_index(0)
+                .focus(|style| style.border_1().border_color(if checked || mixed { theme.bg } else { theme.accent }))
+                .on_key_down(move |event, _, cx| {
+                    if matches!(event.keystroke.key.as_str(), "space" | "enter") && !event.keystroke.modifiers.modified() {
+                        cx.stop_propagation();
+                        emit_event_full(&keyboard_callback, element_id, "toggleChange", |p| p.value = keyboard_value.as_deref().cloned());
+                    }
+                });
+        }
+    }
+    if first_row && (checked || mixed) {
+        let icon: &[u8] = if mixed {
+            br##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M4 8h8" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round"/></svg>"##
+        } else {
+            br##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M3 8l3 3 7-7" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>"##
+        };
+        cell = cell.child(gpui::svg().data(icon).size(px(m.diff_text_size))
+            .flex_none().text_color(theme.bg));
+    }
+    cell.into_any_element()
+}
