+}
+
+fn decoration_offset(text: &str, offset: usize) -> Option<usize> {
+    let byte_offset = utf16_offset_to_utf8(text, offset);
+    (text[..byte_offset].encode_utf16().count() == offset).then_some(byte_offset)
+}
+
+fn decorated_text_runs(
+    text: &str,
+    base: TextRun,
+    colors: &[TextColorRange],
+    marked: Option<&Range<usize>>,
+) -> Vec<TextRun> {
+    let colors: Vec<_> = colors.iter().take(8).filter_map(|color| {
+        let range = decoration_offset(text, color.start)?..decoration_offset(text, color.end)?;
+        let ink = crate::color::parse_color_rgba(&color.color)?;
+        (range.start < range.end).then_some((range, gpui::Hsla::from(ink)))
+    }).collect();
+    let marked = marked.filter(|range| {
+        range.start < range.end && range.end <= text.len()
+            && text.is_char_boundary(range.start) && text.is_char_boundary(range.end)
+    });
+    if colors.is_empty() && marked.is_none() {
+        return vec![base];
+    }
+    let mut boundaries = vec![0, text.len()];
+    for (range, _) in &colors {
+        boundaries.extend([range.start, range.end]);
+    }
+    if let Some(range) = marked {
+        boundaries.extend([range.start, range.end]);
+    }
+    boundaries.sort_unstable();
+    boundaries.dedup();
+    boundaries.windows(2).map(|segment| {
+        let mut run = base.clone();
+        run.len = segment[1] - segment[0];
+        if let Some((_, ink)) = colors.iter().rev().find(|(range, _)| range.contains(&segment[0])) {
+            run.color = *ink;
+        }
+        if marked.is_some_and(|range| range.contains(&segment[0])) {
+            run.underline = Some(UnderlineStyle {
+                color: Some(run.color), thickness: px(1.0), wavy: false,
+            });
+        }
+        run
+    }).collect()
+}
+
+fn line_placeholder_offset(text: &str, placeholder: &LinePlaceholder) -> Option<usize> {
+    let offset = decoration_offset(text, placeholder.offset)?;
+    if offset == 0 || text.as_bytes().get(offset - 1) != Some(&b'\n')
+        || !text[offset..].trim().is_empty() {
+        return None;
+    }
+    Some(offset)
+}
