 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn color_decoration_keeps_ime_underlines_and_byte_lengths() {
+        let base = TextRun {
+            len: 10, font: gpui::Font::default(), color: gpui::rgba(0x000000ff).into(),
+            background_color: None, underline: None, strikethrough: None,
+        };
+        let color = TextColorRange { start: 0, end: 4, color: "#00ff00".into() };
+        let runs = decorated_text_runs("abcdefghij", base.clone(), &[color], Some(&(2..7)));
+        assert_eq!(runs.iter().map(|run| run.len).collect::<Vec<_>>(), vec![2, 2, 3, 3]);
+        assert_eq!(runs.iter().map(|run| run.underline.is_some()).collect::<Vec<_>>(), vec![false, true, true, false]);
+        assert_eq!(runs[0].color, gpui::Hsla::from(gpui::rgba(0x00ff00ff)));
+        assert_eq!(runs[1].color, runs[0].color);
+        assert_eq!(runs[2].color, base.color);
+        assert_eq!(runs[3].color, base.color);
+        assert!(runs.iter().all(|run| run.font == base.font && run.background_color.is_none()));
+    }
+
+    #[test]
+    fn decorations_use_exact_utf16_boundaries_and_never_color_inside_a_surrogate() {
+        assert_eq!(decoration_offset("é🙂界", 1), Some(2));
+        assert_eq!(decoration_offset("é🙂界", 2), None);
+        assert_eq!(decoration_offset("é🙂界", 3), Some(6));
+        assert_eq!(decoration_offset("é🙂界", 4), Some(9));
+        assert_eq!(decoration_offset("é🙂界", 5), None);
+    }
+
+    #[test]
+    fn scope_delimiters_are_muted_without_coloring_unicode_or_losing_ime() {
+        let text = "feat(界🙂)!: title";
+        let base = TextRun {
+            len: text.len(), font: gpui::Font::default(), color: gpui::rgba(0x000000ff).into(),
+            background_color: None, underline: None, strikethrough: None,
+        };
+        let color = |start, end, ink: &str| TextColorRange { start, end, color: ink.into() };
+        let runs = decorated_text_runs(text, base.clone(), &[
+            color(0, 4, "#00ff00"), color(4, 5, "#888888"), color(8, 9, "#888888"),
+            color(7, 8, "#ff0000"), color(99, 100, "#ff0000"), color(0, 4, "invalid"),
+        ], Some(&(4..13)));
+        assert_eq!(runs.iter().map(|run| run.len).collect::<Vec<_>>(), vec![4, 1, 7, 1, 8]);
+        assert_eq!(runs.iter().map(|run| run.underline.is_some()).collect::<Vec<_>>(), vec![false, true, true, true, false]);
+        assert_eq!(runs[0].color, gpui::Hsla::from(gpui::rgba(0x00ff00ff)));
+        assert_eq!(runs[1].color, gpui::Hsla::from(gpui::rgba(0x888888ff)));
+        assert_eq!(runs[2].color, base.color);
+        assert_eq!(runs[3].color, runs[1].color);
+        assert_eq!(runs[4].color, base.color);
+        assert_eq!(runs.iter().map(|run| run.len).sum::<usize>(), text.len());
+        assert!(runs.iter().all(|run| run.font == base.font && run.background_color.is_none()));
+    }
