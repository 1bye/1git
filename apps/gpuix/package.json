{
  "name": "@1git/gpuix",
  "version": "0.0.1",
  "description": "GPUix-native desktop shell for 1git",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "bun --hot src/main.tsx",
    "screenshot": "bun src/main.tsx --screenshot=screenshots/gpuix-vertical-slice.png",
    "start": "bun dist/main.js",
    "test": "bun test tests"
  },
  "dependencies": {
    "@1git/git": "workspace:*",
    "@gpuix/react": "0.4.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
