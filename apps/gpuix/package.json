{
  "name": "@1git/gpuix",
  "version": "0.0.1",
  "private": true,
  "description": "Native GPUIX workspace shell for 1git",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "bun native/build.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "dev": "bun --preload ./native/preload.ts --hot src/main.tsx",
    "start": "bun --preload ./native/preload.ts dist/main.js",
    "test": "bun test --preload ./native/preload.ts --path-ignore-patterns '**/*.integration.test.ts' tests",
    "test:integration": "bun test tests/repository-connection/repository-reader.integration.test.ts tests/repository-diff/repository-diff.integration.test.ts tests/repository-history/history.integration.test.ts tests/repository-stashes/stashes.integration.test.ts tests/workspace-tabs/repository-branches.integration.test.ts tests/repository-sync/sync.integration.test.ts tests/workspace-session/store.integration.test.ts tests/close-protection/native.integration.test.ts"
  },
  "dependencies": {
    "@1git/git": "workspace:*",
    "@1git/design-tokens": "workspace:*",
    "@1git/gpuix-ui": "workspace:*",
    "@1git/gpuix-stylesheet": "workspace:*",
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "react": "^19.2.4",
    "saxes": "6.0.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@1git/config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
